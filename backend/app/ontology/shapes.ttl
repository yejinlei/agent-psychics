psy:EthicsShape
    rdfs:label "伦理规范形状"@zh ;
    sh:targetClass psy:Ethics ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^ETH[0-9]{2}$" ;
        sh:message "Ethics.id 必须形如 ETH01.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:issuing_body ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:year ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1900 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:jurisdiction ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:key_points_zh ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:supersedes ;
        sh:maxCount 1 ;
        sh:pattern "^ETH[0-9]{2}$" ;
    ] .

