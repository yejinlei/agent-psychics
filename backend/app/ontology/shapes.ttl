        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:year ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive -500 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:actors ;
        sh:maxCount 30 ;
        sh:pattern "^PSY[0-9]{3}$" ;
    ], [
        sh:path psy:school_ids ;
        sh:maxCount 10 ;
        sh:pattern "^SCH[0-9]{2}$" ;
    ] .

# =====================================================================
# InstitutionShape
# =====================================================================
psy:InstitutionShape
    rdfs:label "机构形状"@zh ;
    sh:targetClass psy:Institution ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^INS[0-9]{3}$" ;
        sh:message "Institution.id 必须形如 INS001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:kind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "实验室" "研究所" "协会" "学会" "期刊" "学院" ) ;
        sh:message "Institution.kind 必须属于受控词表.";
    ], [
        sh:path psy:affiliation_school ;
        sh:maxCount 5 ;
        sh:pattern "^SCH[0-9]{2}$" ;
    ], [
        sh:path psy:founded_year ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ], [
        sh:path psy:disbanded_year ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] .

# =====================================================================
# NationShape
# =====================================================================
psy:NationShape
    rdfs:label "国家形状"@zh ;
    sh:targetClass psy:Nation ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^N[0-9]{2}$" ;
        sh:message "Nation.id 必须形如 N01.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:iso3 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[A-Z]{3}$" ;
        sh:message "Nation.iso3 必须是 3 位大写字母.";
    ], [
        sh:path psy:flag_region ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

# =====================================================================
# ClaimShape
# =====================================================================
psy:ClaimShape
    rdfs:label "主张形状"@zh ;
    sh:targetClass psy:Claim ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^CLM[0-9]{4}$" ;
        sh:message "Claim.id 必须形如 CLM0001.";
    ], [
        sh:path psy:title_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Claim 必须包含非空 title_zh.";
    ], [
        sh:path psy:stance ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "肯定" "否定" "存疑" "调和" "评论" "批评" "支持" ) ;
        sh:message "Claim.stance 必须属于受控词表.";
    ], [
        sh:path psy:confidence ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Claim.confidence 必须在 [0.0, 1.0].";
    ], [
        sh:path psy:counter_claim_ids ;
        sh:maxCount 20 ;
        sh:pattern "^CLM[0-9]{4}$" ;
    ] .
