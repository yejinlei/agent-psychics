psy:TopicShape
    rdfs:label "主题形状"@zh ;
    sh:targetClass psy:Topic ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^TOP[0-9]{2}$" ;
        sh:message "Topic.id 必须形如 TOP01.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:category ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:parent_id ;
        sh:maxCount 1 ;
        sh:pattern "^TOP[0-9]{2}$" ;
    ], [
        sh:path psy:related_theories ;
        sh:maxCount 30 ;
        sh:pattern "^THY[0-9]{3}$" ;
    ] .

# =====================================================================
# AssessmentShape
# =====================================================================
psy:AssessmentShape
    rdfs:label "评估工具形状"@zh ;
    sh:targetClass psy:Assessment ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^ASM[0-9]{3}$" ;
        sh:message "Assessment.id 必须形如 ASM001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:kind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "量表" "测验" "访谈" "观察" "投射" ) ;
        sh:message "Assessment.kind 必须属于受控词表.";
    ], [
        sh:path psy:author_ids ;
        sh:maxCount 5 ;
        sh:pattern "^PSY[0-9]{3}$" ;
    ], [
        sh:path psy:evidence_level ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "I" "II" "III" "IV" ) ;
    ], [
        sh:path psy:copyright_status ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "commercial" "free" "public_domain" ) ;
        sh:message "Assessment.copyright_status 必须是 commercial/free/public_domain.";
    ], [
        sh:path psy:target_topics ;
        sh:minCount 1 ;
        sh:pattern "^TOP[0-9]{2}$" ;
    ] .

# =====================================================================
# EthicsShape
