psy:EventShape
    rdfs:label "事件形状"@zh ;
    sh:targetClass psy:Event ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^EVT[0-9]{3}$" ;
        sh:message "Event.id 必须形如 EVT001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
