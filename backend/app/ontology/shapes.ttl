@prefix rdf:    <http://www.w3.org/1999-02-22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix psy:    <https://ontology.agent-psychics.local/ontology#> .
@prefix psyv:   <https://ontology.agent-psychics.local/vocab#> .

<https://ontology.agent-psychics.local/shapes.ttl>
    rdf:type               owl:Ontology ;
    owl:versionIRI         <https://ontology.agent-psychics.local/ontology#v1.0> ;
    owl:versionInfo        "1.0.0" ;
    rdfs:label             "Agent Psychics Ontology SHACL Shapes"@zh ,
                           "Agent Psychics SHACL shapes"@en ;
    rdfs:comment           "本体的形状约束 (SHACL 2.x)。每条主记录至少必须通过对应 NodeShape 才能入库。属性名与 backend/app/ontology/schema.py 中的 Pydantic 字段名保持 snake_case 一致。列表字段（如 school_ids）在 TTL 中以多值 rdf:Property 呈现，本文件用 pattern 约束单个元素。"@zh ;
    sh:namespace          psyv: ;
    sh:declaration        psyv: .

# =====================================================================
# 通用枚举 (rdfs:Datatype 仅作可读性提示，实际校验靠 sh:in / sh:pattern)
# =====================================================================
<https://ontology.agent-psychics.local/vocab#EvidenceLevel> a rdfs:Datatype ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "证据等级：I 荟萃/RCT；II 多项 RCT；III 单组研究；IV 专家共识".

# =====================================================================
# SchoolShape
# =====================================================================
psy:SchoolShape
    rdfs:label "学派形状"@zh ;
    sh:targetClass psy:School ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^SCH[0-9]{2}$" ;
        sh:message "School.id 必须形如 SCH01 (两位数字).";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "School 必须包含非空 name_zh.";
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "School 必须包含非空 name_en.";
    ], [
        sh:path psy:founded_year ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive -500 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:founders ;
        sh:maxCount 20 ;
        sh:pattern "^PSY[0-9]{3}$" ;
        sh:message "School.founders 每个值必须是 PSYxxx.";
    ], [
        sh:path psy:region ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

# =====================================================================
# PsychologistShape
# =====================================================================
psy:PsychologistShape
    rdfs:label "心理学家形状"@zh ;
    sh:targetClass psy:Psychologist ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^PSY[0-9]{3}$" ;
        sh:message "Psychologist.id 必须形如 PSY001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Psychologist 必须包含非空 name_zh.";
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Psychologist 必须包含非空 name_en.";
    ], [
        sh:path psy:gender ;
        sh:minCount 1 ;
        sh:in ( "M" "F" "X" ) ;
        sh:message "Psychologist.gender 必须是 M / F / X.";
    ], [
        sh:path psy:birth_year ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive -500 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:death_year ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive -500 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:affiliation ;
        sh:minCount 1 ;
        sh:pattern "^SCH[0-9]{2}$" ;
        sh:message "Psychologist.affiliation 每个值必须是 SCHxx.";
    ], [
        sh:path psy:mentor_ids ;
        sh:maxCount 5 ;
        sh:pattern "^PSY[0-9]{3}$" ;
    ], [
        sh:path psy:active_field ;
        sh:minCount 1 ;
        sh:pattern "^TOP[0-9]{2}$" ;
        sh:message "Psychologist.active_field 每个值必须是 TOPxx.";
    ] .

# =====================================================================
# TheoryShape
# =====================================================================
psy:TheoryShape
    rdfs:label "理论形状"@zh ;
    sh:targetClass psy:Theory ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^THY[0-9]{3}$" ;
        sh:message "Theory.id 必须形如 THY001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ], [
        sh:path psy:school_ids ;
        sh:minCount 1 ;
        sh:pattern "^SCH[0-9]{2}$" ;
        sh:message "Theory.school_ids 每个值必须是 SCHxx.";
    ], [
        sh:path psy:author_ids ;
        sh:minCount 1 ;
        sh:pattern "^PSY[0-9]{3}$" ;
        sh:message "Theory.author_ids 每个值必须是 PSYxxx.";
    ], [
        sh:path psy:year ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive -500 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:work_ids ;
        sh:maxCount 20 ;
        sh:pattern "^WRK[0-9]{3}$" ;
    ], [
        sh:path psy:paper_ids ;
        sh:maxCount 20 ;
        sh:pattern "^PAP[0-9]{3}$" ;
    ], [
        sh:path psy:concept_ids ;
        sh:maxCount 30 ;
        sh:pattern "^CPT[0-9]{3}$" ;
    ] .

# =====================================================================
# ConceptShape
# =====================================================================
psy:ConceptShape
    rdfs:label "概念形状"@zh ;
    sh:targetClass psy:Concept ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^CPT[0-9]{3}$" ;
        sh:message "Concept.id 必须形如 CPT001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ], [
        sh:path psy:kind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "心理概念" "心理过程" "心理结构" "心理动力" "临床术语" "研究方法" "发展里程碑" ) ;
        sh:message "Concept.kind 必须属于受控词表.";
    ], [
        sh:path psy:school_ids ;
        sh:maxCount 10 ;
        sh:pattern "^SCH[0-9]{2}$" ;
    ], [
        sh:path psy:theory_ids ;
        sh:maxCount 10 ;
        sh:pattern "^THY[0-9]{3}$" ;
    ], [
        sh:path psy:related ;
        sh:maxCount 20 ;
        sh:pattern "^CPT[0-9]{3}$" ;
    ] .

# =====================================================================
# WorkShape
# =====================================================================
psy:WorkShape
    rdfs:label "著作形状"@zh ;
    sh:targetClass psy:Work ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^WRK[0-9]{3}$" ;
        sh:message "Work.id 必须形如 WRK001.";
    ], [
        sh:path psy:title_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Work 必须包含非空 title_zh.";
    ], [
        sh:path psy:title_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ], [
        sh:path psy:author_ids ;
        sh:minCount 1 ;
        sh:pattern "^PSY[0-9]{3}$" ;
    ], [
        sh:path psy:year ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive -500 ;
        sh:maxInclusive 2030 ;
    ], [
        sh:path psy:language ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "zh" "en" "de" "fr" "it" "ru" "jp" "other" ) ;
        sh:message "Work.language 必须属于受控词表.";
    ], [
        sh:path psy:theory_ids ;
        sh:maxCount 10 ;
        sh:pattern "^THY[0-9]{3}$" ;
    ] .

# =====================================================================
# PaperShape
# =====================================================================
psy:PaperShape
    rdfs:label "论文形状"@zh ;
    sh:targetClass psy:Paper ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^PAP[0-9]{3}$" ;
        sh:message "Paper.id 必须形如 PAP001.";
    ], [
        sh:path psy:title_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:title_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:author_ids ;
        sh:minCount 1 ;
        sh:pattern "^PSY[0-9]{3}$" ;
    ], [
        sh:path psy:year ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1790 ;
        sh:maxInclusive 2030 ;
        sh:message "Paper.year 应在 1790..2030 之间.";
    ], [
        sh:path psy:doi ;
        sh:maxCount 1 ;
        sh:pattern "^10\\.\\d{4,9}/.+$" ;
        sh:message "Paper.doi 若非空必须形如 10.xxxx/xxxxx.";
    ], [
        sh:path psy:citation_count_approx ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
    ] .

# =====================================================================
# MethodShape
# =====================================================================
psy:MethodShape
    rdfs:label "方法形状"@zh ;
    sh:targetClass psy:Method ;
    sh:property [
        sh:path psy:id ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^MTH[0-9]{3}$" ;
        sh:message "Method.id 必须形如 MTH001.";
    ], [
        sh:path psy:name_zh ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:name_en ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ], [
        sh:path psy:kind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "治疗技术" "研究方法" "评估方法" "测量工具" "量表" ) ;
        sh:message "Method.kind 必须属于受控词表.";
    ], [
        sh:path psy:school_ids ;
        sh:maxCount 5 ;
        sh:pattern "^SCH[0-9]{2}$" ;
    ], [
        sh:path psy:author_ids ;
        sh:maxCount 5 ;
        sh:pattern "^PSY[0-9]{3}$" ;
    ], [
        sh:path psy:target_topics ;
        sh:minCount 1 ;
        sh:pattern "^TOP[0-9]{2}$" ;
        sh:message "Method.target_topics 每个值必须是 TOPxx.";
    ], [
        sh:path psy:evidence_level ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "I" "II" "III" "IV" ) ;
        sh:message "Method.evidence_level 必须是 I/II/III/IV.";
    ] .

