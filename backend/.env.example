# ============================================================
# agent-psychics 后端配置示例
# 复制为 .env 后填入真实值。空值字段自动跳过对应能力。
# ============================================================

# ---------- 主模型（Chat Completion，OpenAI 兼容协议） ----------
# 参考 nobel-kg 多 provider 策略：OpenRouter / SiliconFlow / DeepSeek / 自建中转
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=60
# OpenRouter 附加头（可选，用于流量归属）
OPENROUTER_REFERER=https://agent-psychics.local
OPENROUTER_TITLE=Psychics Ontology Agent

# ---------- 备用模型（可选；主模型失败时切换） ----------
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------- ASR（语音转文字） ----------
# provider 可选：
#   openai  → OpenAI Whisper API（默认，需要 LLM_API_KEY 或下面单独 key）
#   local   → 本地 whisper.cpp / openai-whisper（pip install openai-whisper）
ASR_PROVIDER=openai
ASR_MODEL=whisper-1
ASR_API_KEY=                     # 留空则复用 LLM_API_KEY
ASR_BASE_URL=                    # 留空则复用 LLM_BASE_URL
# 本地模型名（openai-whisper）：tiny / base / small / medium / large
LOCAL_WHISPER_MODEL=base

# ---------- TTS（文字转语音） ----------
# provider 可选：
#   openai      → OpenAI TTS（tts-1 / tts-1-hd）
#   cosyvoice   → 阿里云 DashScope CosyVoice
#   pyttsx3     → 本地 Windows SAPI（兜底，无需 Key）
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy                   # alloy | echo | fable | onyx | nova | shimmer | coral | sage
TTS_API_KEY=                     # 留空则复用 LLM_API_KEY
TTS_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=cosyvoice-v2
DASHSCOPE_VOICE=longxiaochun

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# ---------- 治理 ----------
# 关闭 strict 时，五闸门校验的 WARN 不会阻断启动
ONTOLOGY_STRICT=false
